{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f5f6f8" },
      "200": { "$value": "#d9dce1" },
      "600": { "$value": "#565d6b" },
      "900": { "$value": "#14171c" }
    },
    "brand": {
      "500": { "$value": "#2f5bd3" },
      "700": { "$value": "#1f3f9e" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.600}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "link": { "$value": "{color.brand.500}" },
      "link-hover": { "$value": "{color.brand.700}" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle": { "$value": "{color.neutral.50}" }
    },
    "border": {
      "subtle": { "$value": "{color.neutral.200}" }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "s": { "$value": "8px" },
    "m": { "$value": "16px" },
    "l": { "$value": "24px" },
    "xl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px" },
    "m": { "$value": "8px" },
    "pill": { "$value": "2.4em" }
  }
}
