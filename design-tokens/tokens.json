{
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#f8f8f8" },
      "200": { "$value": "#dadada" },
      "600": { "$value": "#505050" },
      "900": { "$value": "#131313" }
    },
    "brand": {
      "500": { "$value": "#3b63fb" },
      "700": { "$value": "#1d3ecf" }
    },
    "ink": {
      "300": { "$value": "#9aa0b0" },
      "950": { "$value": "#0a0a0f" }
    },
    "neon": {
      "cyan": { "$value": "#00e5ff" },
      "magenta": { "$value": "#ff1f8e" }
    },
    "text": {
      "default": { "$value": "{color.neutral.900}" },
      "muted": { "$value": "{color.neutral.600}" },
      "inverse": { "$value": "{color.neutral.0}" },
      "link": { "$value": "{color.brand.500}" },
      "link-hover": { "$value": "{color.brand.700}" }
    },
    "surface": {
      "default": { "$value": "{color.neutral.0}" },
      "subtle": { "$value": "{color.neutral.50}" }
    },
    "border": {
      "subtle": { "$value": "{color.neutral.200}" }
    },
    "terminal": {
      "surface": { "$value": "{color.ink.950}" },
      "text": { "$value": "{color.neutral.0}" },
      "text-muted": { "$value": "{color.ink.300}" },
      "accent": { "$value": "{color.neon.cyan}" },
      "highlight": { "$value": "{color.neon.magenta}" }
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "s": { "$value": "8px" },
    "m": { "$value": "16px" },
    "l": { "$value": "24px" },
    "xl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "s": { "$value": "4px" },
    "m": { "$value": "8px" },
    "pill": { "$value": "2.4em" }
  }
}
